{
  "name": "xiaoxiaoyu",
  "version": "3.1.1",
  "description": "小小榆 - 多模型AI桌面助手",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && npm run build:main && .\\node_modules\\.bin\\electron.cmd . --dev",
    "dev:watch": "node scripts/dev-watch.js",
    "build": "npm run build:renderer && npm run build:main",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "pack": "npm run build && electron-builder --win --x64",
    "pack:dir": "npm run build && electron-builder --win --x64 --dir",
    "pack:portable": "npm run build && electron-builder --win portable --x64",
    "pack:mac": "npm run build && electron-builder --mac",
    "pack:mac:arm64": "npm run build && electron-builder --mac --arm64",
    "pack:mac:x64": "npm run build && electron-builder --mac --x64",
    "pack:all": "npm run build && electron-builder --win --x64 --mac",
    "test": "npm run test:smoke",
    "test:smoke": "tsx _test/auth-smoke.mts && node _test/agent-tools-sandbox.cjs && node _test/file-ipc-sandbox.cjs && node _test/crypto-smoke.cjs && node _test/openai-compat-check.cjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "antd": "^5.22.0",
    "highlight.js": "^11.10.0",
    "node-pty": "^1.1.0",
    "nodemailer": "^10.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.0",
    "react-router-dom": "^6.28.0",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "sql.js": "^1.11.0",
    "ssh2": "^1.17.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.0",
    "monaco-editor": "^0.56.0",
    "tsx": "^4.23.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.xiaoxiaoyu.desktop",
    "productName": "小小榆",
    "copyright": "Copyright 2025",
    "afterPack": "scripts/patch-win-exe.cjs",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/models",
        "to": "models"
      }
    ],
    "asar": false,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/sql.js/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "小小榆-${version}-macOS.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "小小榆不需要访问麦克风",
        "NSCameraUsageDescription": "小小榆不需要访问摄像头"
      }
    },
    "dmg": {
      "title": "小小榆 ${version}",
      "background": "resources/dmg-background.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "artifactName": "XiaoXiaoYu-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "unicode": true,
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "小小榆",
      "license": "LICENSE"
    }
  }
}
